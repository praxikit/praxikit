{
  "description": "Keel: (1) refuse a sub-agent launch that names no model, so the lead's expensive model never runs one by accident; (2) warn once per session when an edit lands outside the current phase's Files list.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/require-model.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/drift.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
